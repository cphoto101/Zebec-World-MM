rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /profileAvatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /posters/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 10 * 1024 * 1024;
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 10 * 1024 * 1024;
    }
    match /chapters/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
